# Copy to .env and fill in: cp .env.example .env && docker compose up -d --build
# .env is git-ignored. Never commit real credentials.

# --- Required ---------------------------------------------------------------
# HTTPS base URL of your Nightscout site
NIGHTSCOUT_URL=https://your-nightscout.example
# Raw API_SECRET (with NIGHTSCOUT_AUTH_MODE=secret) or an access token (with token)
NIGHTSCOUT_CREDENTIAL=
# Password for the app login (pick a long one)
APP_PASSWORD=

# --- Optional ---------------------------------------------------------------
# secret (default: sends the SHA-1 of API_SECRET) or token
NIGHTSCOUT_AUTH_MODE=secret
# Home time zone if the Nightscout profile has none
APP_TIMEZONE=Europe/Berlin
# Language of server texts, push messages and the meal agent: de or en (the page follows the browser)
APP_LANGUAGE=en
# Rapid-insulin action profile from app/insulin.py (upstream ships fiasp only; forks can add more)
APP_INSULIN=fiasp
# Minutes between background syncs with Nightscout (0 = off)
APP_SYNC_MINUTES=2
# Where the container's port is published; keep 127.0.0.1 behind a reverse proxy with HTTPS
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8765
# Host directory for the SQLite database and photos, writable for APP_UID/APP_GID
APP_DATA_DIR=./data
APP_UID=1000
APP_GID=1000

# Read-only JSON API /api/v1 for scripts (at least 32 characters, e.g. openssl rand -hex 32)
API_READ_KEY=
# MCP server /mcp for an AI agent with write access (at least 32 characters), see docs/mcp.md
MCP_API_KEY=
# Extra OAuth redirect URIs for MCP clients other than Claude, comma-separated
MCP_OAUTH_REDIRECTS=

# Meal agent (carb estimates from photos and text): any one of these is enough; leave all empty to turn it off
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter also powers voice input (speech to text)
OPENROUTER_API_KEY=

# Push reminders and early warnings via Pushover (both needed)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Public HTTPS address of the app; push messages link there
APP_PUBLIC_URL=
# Pinged after every error-free background round, for an external watchdog (e.g. Healthchecks.io)
APP_HEARTBEAT_URL=
