# Copy to .env and fill in: cp .env.example .env
# docker compose reads this file for the variables in compose.yaml. Never commit .env.

# Required. NIGHTSCOUT_CREDENTIAL is the raw API_SECRET or an access token,
# APP_PASSWORD the password for the app login.
NIGHTSCOUT_URL=https://your-nightscout.example
NIGHTSCOUT_CREDENTIAL=
APP_PASSWORD=

# Nightscout login: secret (API_SECRET, default) or token.
NIGHTSCOUT_AUTH_MODE=secret

# Language of server texts, push messages and the meal agent: de (default) or en.
# The web interface follows the browser independently.
APP_LANGUAGE=de
APP_TIMEZONE=Europe/Berlin

# Rapid-insulin action profile from app/insulin.py (upstream ships fiasp only; forks can add more).
APP_INSULIN=fiasp

# Background sync with Nightscout in minutes, 0 = off.
APP_SYNC_MINUTES=2

# Where the app listens and keeps its data.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8765
APP_DATA_DIR=./data
APP_UID=1000
APP_GID=1000

# Optional: read API and MCP, each at least 32 characters (openssl rand -hex 32).
API_READ_KEY=
MCP_API_KEY=

# Optional: meal agent, one provider is enough.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Pushover reminders and monitoring.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
APP_PUBLIC_URL=
APP_HEARTBEAT_URL=
